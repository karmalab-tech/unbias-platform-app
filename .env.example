# Copy to .env and fill in. Loaded in development/test by dotenv-rails.

# Site-wide password gate, asked once per browser session and independent from
# user sign-in. Leave unset/blank to disable the gate entirely.
# PASSWORD=

# Action Mailer
MAILER_SENDER=no-reply@example.com

# S3-compatible storage for Active Storage (production).
# Plain AWS S3: set AWS_BUCKET and leave AWS_ENDPOINT_URL_S3 unset.
# Other providers (Tigris, R2, MinIO, …) need the endpoint, and some inject
# BUCKET_NAME instead of AWS_BUCKET.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET=
# AWS_ENDPOINT_URL_S3=
# BUCKET_NAME=

# Active Record connection pool. Defaults to RAILS_MAX_THREADS when unset; set
# it higher than RAILS_MAX_THREADS when Solid Queue workers share the pool.
# DB_POOL=

# First admin account created by `bin/rails db:seed`. Change the password after
# the first sign-in.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Public host used in emails and QR codes (no scheme), e.g. unbias-ai.fly.dev
APP_HOST=localhost:3000

# Intro video (self-hosted MP4 on a CDN; autoplays muted in installation mode).
# INTRO_VIDEO_URL=
# INTRO_VIDEO_POSTER_URL=
# INTRO_VIDEO_SUBTITLES_URL=

# Server-side enrichment (context, neutral caption, advisory safety flags). Leave unset to skip:
# photos still reach moderation with a "processing failed" flag.
# ANTHROPIC_API_KEY=
