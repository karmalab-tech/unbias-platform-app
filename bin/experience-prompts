#!/usr/bin/env -S node --no-warnings
// Prints the generation manifest of the bias experience as CSV: one row per prompt to run IMAGES_PER_PROMPT times.
import {
  IMAGES_PER_PROMPT,
  allSelections,
  nodeId,
  promptText,
} from "../app/frontend/lib/experience.js";

const quote = (value) => `"${String(value).replaceAll('"', '""')}"`;

console.log("folder,depth,images,prompt,prompt_fr");
for (const selection of allSelections()) {
  console.log(
    [
      nodeId(selection),
      selection.length,
      IMAGES_PER_PROMPT,
      quote(promptText(selection)),
      quote(promptText(selection, "fr")),
    ].join(",")
  );
}
